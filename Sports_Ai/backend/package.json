{
  "name": "sportsai-backend",
  "version": "5.0.0",
  "description": "SportsAI Platform Backend - Arbitrage Priority",
  "main": "dist/index.js",
  "scripts": {
    "postinstall": "prisma generate && (npx playwright install chromium || true)",
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && (prisma db push || true) && tsc",
    "start": "node dist/index.js",
    "vercel-build": "prisma generate && tsc",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src test",
    "lint:fix": "eslint src test --fix",
    "typecheck": "tsc --noEmit",
    "verify": "npm run lint && npm test -- --runInBand && npm run typecheck && npm audit --omit=dev --omit=optional --audit-level=high",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:create-user": "tsx create-user.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/helmet": "^13.0.2",
    "@fastify/multipart": "^10.1.0",
    "@fastify/static": "^10.1.2",
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.28",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-fastify": "^11.1.28",
    "@nestjs/platform-socket.io": "^11.1.28",
    "@nestjs/schedule": "^6.1.0",
    "@nestjs/swagger": "^11.4.6",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^11.1.28",
    "@prisma/client": "^6.19.1",
    "@swc-node/register": "^1.11.1",
    "@swc/helpers": "^0.5.18",
    "@types/bcryptjs": "^2.4.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/qrcode": "^1.5.6",
    "axios": "^1.18.1",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.0",
    "class-validator": "^0.14.0",
    "dotenv": "^17.2.3",
    "ioredis": "^5.3.0",
    "kafkajs": "^2.2.0",
    "otplib": "^13.0.2",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.0",
    "playwright": "^1.57.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0",
    "tsx": "^4.21.0",
    "uuid": "^13.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@swc/core": "^1.15.11",
    "@swc/jest": "^0.2.39",
    "@types/cron": "^2.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "@types/uuid": "^10.0.0",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "jest": "^30.4.2",
    "prisma": "^6.19.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0"
  },
  "overrides": {
    "babel-plugin-istanbul": "8.0.0",
    "brace-expansion": "5.0.8",
    "defu": "^6.1.7",
    "effect": "^3.22.0",
    "find-my-way": "^9.7.0",
    "form-data": "^4.0.6",
    "glob": "13.0.6",
    "js-yaml": "^5.2.2",
    "minimatch": "10.2.5",
    "test-exclude": "8.0.0"
  }
}
