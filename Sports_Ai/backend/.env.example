# SportsAI Backend Environment Variables
# Copy this to .env and fill in your values

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/sportsai

# Authentication (use independent random values with at least 32 characters)
# Example generator: openssl rand -hex 32
JWT_SECRET=
COOKIE_SECRET=

# Telegram webhook authentication (set the same value as Telegram's secret_token)
TELEGRAM_WEBHOOK_SECRET=

# Comma-separated exact HTTPS frontend origins (wildcards are rejected)
CORS_ORIGIN=https://sports-ai-one.vercel.app

# OpenRouter (AI predictions, sentiment analysis)
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# The Odds API (live odds - https://the-odds-api.com)
# Free: 500 credits/mo at https://the-odds-api.com
THE_ODDS_API_KEY=your-odds-api-key

# Port
PORT=3001
